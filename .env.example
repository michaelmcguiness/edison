# Current personal, non-commercial sample-data demo (Vercel Hobby).
# This server-only flag is the ONLY environment value needed for the demo.
# Set it in Vercel Production AND Preview; do not add live-service credentials.
# Account/reading state resets on reload; optional editorial drafts and direction
# remain device-local. No real auth, server persistence, or AI is enabled.
# Set false or remove it only in the separate production private-alpha web project.
EDISON_DEMO_MODE=true

# Everything below is for the production private-alpha stack, not the hosted demo.
# Web client
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical web origin used by the API when it creates public share links.
WEB_APP_URL=http://localhost:3000

# API authentication
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Current Supabase sb_secret_ key; never expose it to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Required and fail-closed in production; comma-separated private-alpha readers.
EDISON_ALLOWED_EMAILS=
# Every admin must also appear in the required private-alpha allowlist above.
EDISON_ADMIN_EMAILS=

# Supabase's transaction pooler in production; local Postgres in development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Use the direct connection for migrations and backups.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only AI configuration. Never use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=
# Cost accounting recognizes only these explicitly priced model families.
OPENAI_ARTICLE_MODEL=gpt-5.6-terra
OPENAI_UTILITY_MODEL=gpt-5.6-luna
OPENAI_MAX_DAILY_GENERATIONS=8
# Per-reader rolling-24-hour reservations. Required and validated by the API.
OPENAI_MAX_DAILY_ARTICLE_QUESTIONS=20
OPENAI_MAX_DAILY_FEED_COMMANDS=10
# $0.01/call as of 2026-09-02; recheck OpenAI pricing before launch changes.
OPENAI_WEB_SEARCH_COST_MICROUSD=10000

# Comma-separated browser origins. Native apps are not subject to CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local-only fallback identity. It is rejected when NODE_ENV=production.
EDISON_DEV_USER_ID=00000000-0000-4000-8000-000000000001
EDISON_DEV_USER_EMAIL=reader@edison.local

# Protect internal scheduled-job routes.
CRON_SECRET=

# Daily editions begin after this local hour and catch up hourly until midnight.
EDISON_DAILY_EDITION_LOCAL_HOUR=5
EDISON_DAILY_EDITION_TARGET=3
EDISON_DAILY_EDITION_BATCH_SIZE=25
